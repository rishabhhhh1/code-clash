# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgres://user:password@localhost:5432/codeclash
# Neon:    postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/codeclash
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens — set any long random string in production
JWT_SECRET=change-this-before-deploying

# ─── Codeforces API ───────────────────────────────────────────────────────────
# Get these from: https://codeforces.com → Settings → API Keys → Add API Key
# Leave blank if not using CF-authenticated features
CF_API_KEY=
CF_API_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
# Port for the API server (default 8080)
PORT=8080
