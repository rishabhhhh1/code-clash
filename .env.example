# CodeClash Environment Variables

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Get from: https://console.neon.tech/app/projects
# Use the connection string with ?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/codeclash?sslmode=require"

# ============================================
# REDIS (Upstash Redis)
# ============================================
# Get from: https://console.upstash.com/app/xxx/redis
# Use the REDIS_URL from Upstash dashboard
REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# ============================================
# JWT
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ============================================
# OAUTH - Google
# ============================================
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URIs:
#    - http://localhost:3000/auth/callback/google (development)
#    - https://your-app.vercel.app/auth/callback/google (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/callback/google"

# ============================================
# OAUTH - GitHub
# ============================================
# 1. Go to https://github.com/settings/developers
# 2. Create new OAuth App
# 3. Authorization callback URL:
#    - http://localhost:3000/auth/callback/github (development)
#    - https://your-app.vercel.app/auth/callback/github (production)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/auth/callback/github"

# ============================================
# APP URLS
# ============================================
# Backend API URL (Railway)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Production: https://your-api.up.railway.app

# WebSocket URL (same as API for Socket.IO)
NEXT_PUBLIC_WS_URL="http://localhost:3001"
# Production: wss://your-api.up.railway.app

# Frontend URL (Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://your-app.vercel.app

# ============================================
# JUDGE (Code Execution)
# ============================================
JUDGE_DOCKER_IMAGE="codeclash-judge:latest"
JUDGE_TIMEOUT_MS=10000
