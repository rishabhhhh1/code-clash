generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(uuid())
  codeforcesHandle         String               @unique
  avatar                   String?
  bio                      String?
  rating                   Int                  @default(1000)
  rank                     String               @default("silver")
  totalBattles             Int                  @default(0)
  wins                     Int                  @default(0)
  losses                   Int                  @default(0)
  draws                    Int                  @default(0)
  codeforcesRating         Int?
  codeforcesMaxRating      Int?
  codeforcesRank           String?
  codeforcesTitlePhoto     String?
  codeforcesVerified       Boolean              @default(false)
  codeforcesLastSync       DateTime?
  emailNotifications       Boolean              @default(true)
  battleInvites            Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdBattles           Battle[]
  battles                  BattlePlayer[]
  matchHistory             MatchHistory[]
  submissions              Submission[]

  @@index([rating(sort: Desc)])
  @@index([codeforcesHandle])
}


model Problem {
  id              String   @id @default(uuid())
  contestId       Int
  index           String
  name            String
  rating          Int?
  tags            String[]
  points          Float?
  type            String   @default("PROGRAMMING")
  problemsetName  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contestId, index])
  @@index([rating])
  @@index([tags])
  @@index([isActive])
}

model Battle {
  id           String         @id @default(uuid())
  code         String         @unique
  creatorId    String
  contestId    Int?
  problemIndex String?
  mode         String
  status       String         @default("waiting")
  playerCount  Int            @default(0)
  maxPlayers   Int            @default(2)
  difficulty   String
  topics       String[]
  timeControl  Int            @default(10)
  isPublic     Boolean        @default(true)
  inviteCode   String?
  startTime    DateTime?
  endTime      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creator      User           @relation(fields: [creatorId], references: [id])
  players      BattlePlayer[]
  matchHistory MatchHistory[]
  submissions  Submission[]

  @@index([code])
  @@index([status])
  @@index([isPublic])
  @@index([contestId, problemIndex])
}

model BattlePlayer {
  id               String   @id @default(uuid())
  battleId         String
  userId           String
  score            Int      @default(0)
  rank             Int      @default(0)
  problemsSolved   Int      @default(0)
  submissionsCount Int      @default(0)
  isAlive          Boolean  @default(true)
  joinedAt         DateTime @default(now())
  battle           Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model Submission {
  id           String   @id @default(uuid())
  battleId     String
  userId       String
  contestId    Int
  problemIndex String
  code         String
  language     String
  status       String   @default("pending")
  runtime      Int?
  memory       Int?
  score        Int      @default(0)
  createdAt    DateTime @default(now())
  battle       Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([userId])
  @@index([contestId, problemIndex])
}

model MatchHistory {
  id           String   @id @default(uuid())
  userId       String
  battleId     String
  placement    Int
  ratingChange Int
  topicsPlayed String[]
  createdAt    DateTime @default(now())
  battle       Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([battleId])
}

model DailyChallenge {
  id          String   @id @default(uuid())
  date        DateTime @unique
  problemIds  String[]
  leaderboard Json
  createdAt   DateTime @default(now())

  @@index([date])
}
